# ===== Frontend (React) — salin ke frontend/.env lalu isi nilainya =====
# Nilai REACT_APP_* ditanam saat build (yarn build). Ubah nilai = build ulang.

# Alamat backend TANPA "/api" dan tanpa garis miring di akhir.
# - KOSONGKAN (disarankan) bila frontend memakai proxy /api di domain yang sama
#   (Vercel: middleware.js + env BACKEND_URL; Render: rewrite /api/*). Foto, sampul,
#   dan login cookie paling andal dengan cara ini.
# - Isi (mis. https://perpus-backend.onrender.com) bila frontend memanggil backend langsung.
# - Pengembangan lokal: http://localhost:8001
REACT_APP_BACKEND_URL=

# [OPSIONAL, hanya dev server lokal] port websocket hot reload. Hapus bila tidak perlu.
# WDS_SOCKET_PORT=443

# [OPSIONAL, hanya dev server] endpoint health-check webpack.
ENABLE_HEALTH_CHECK=false

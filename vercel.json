{
  "version": 2,
  "installCommand": "npm install --prefix frontend --force",
  "buildCommand": "CI=false npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "framework": null,
  "headers": [
    { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.json", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/static/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://library-devilatifa.emergent.host/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

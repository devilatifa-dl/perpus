# ===== Backend (FastAPI) — salin ke backend/.env lalu isi nilainya =====

# [WAJIB] Alamat koneksi MongoDB. Lokal: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# [WAJIB] Nama database di dalam MongoDB.
DB_NAME=perpus

# [WAJIB] Kunci rahasia untuk token login, minimal 32 karakter acak.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
# Mengganti nilai ini membuat semua orang harus login ulang.
JWT_SECRET=ganti-dengan-64-karakter-acak-hasil-perintah-di-atas-0000000000

# [DISARANKAN] Alamat web frontend (tanpa garis miring di akhir). Otomatis diizinkan CORS.
# Contoh: https://perpusmansa.vercel.app atau https://perpus-frontend.onrender.com
FRONTEND_URL=http://localhost:3000

# [OPSIONAL] Asal tambahan yang boleh memanggil API, dipisah koma.
# "*" = izinkan semua asal (hanya untuk uji coba; jangan dipakai di produksi).
# Kosongkan bila frontend memakai proxy /api (Vercel middleware / Render rewrite) — CORS tidak dibutuhkan.
CORS_ORIGINS=

# [OPSIONAL] Pola regex asal yang diizinkan, mis. untuk semua preview Vercel:
# ^https://perpus-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
